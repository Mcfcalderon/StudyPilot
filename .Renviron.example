# ============ StudyPilot — Variables de Entorno (ejemplo) ============
# Copia este archivo como .Renviron (local) o app_env (deploy) y completa tus valores.
# NUNCA subas .Renviron ni app_env a GitHub (estan en .gitignore).

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/studypilot

# --- Google Gemini ---
# Crea claves en https://aistudio.google.com/apikey
# Para MAS cuota, crea varias claves (idealmente con 2-3 cuentas Google
# distintas = cuotas independientes) y ponlas SEPARADAS POR COMA.
# La app las rota automaticamente cuando una llega a su limite (error 429).
GEMINI_KEYS=AIza...clave1,AIza...clave2,AIza...clave3
# Alternativa de una sola clave (opcional; tambien se suma al pool):
GEMINI_API_KEY=AIza...tu_clave

# --- Admin (opcional) ---
STUDYPILOT_ADMIN_USERS=usuario:password:Nombre
